{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Maid",
  "version": "0.1.0",
  "identifier": "com.themaid.app",
  "build": {
    "beforeDevCommand": "cd /tmp/the-maid-ui-fix/src/the-maid/src 00260026 npm run dev",
    "beforeBuildCommand": "cd /tmp/the-maid-ui-fix/src/the-maid/src 00260026 npm run build",
    "frontendDist": "../src/dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "The Maid",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://themaid.app https://models.themaid.app"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/the-maid-backend.tar.gz",
      "resources/llama/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "./windows/installer-hooks.nsi",
        "headerImage": null,
        "sidebarImage": null
      }
    }
  }
}