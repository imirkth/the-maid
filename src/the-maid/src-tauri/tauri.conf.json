{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Maid",
  "version": "0.1.0",
  "identifier": "com.themaid.app",
  "build": {
    "beforeDevCommand": "cd ../src && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cd ../src && npm run build",
    "frontendDist": "../src/dist"
  },
  "app": {
    "windows": [
      {
        "title": "The Maid",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "sidebarHtml": null
      }
    }
  }
}
